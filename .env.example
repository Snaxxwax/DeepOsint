# Server (development is bound to loopback; production requires an API_TOKEN)
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=
PYTHON_BIN=python3

# Optional semantic extraction. Only enabled per request with useGeminiNlp=true.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public search: none, searxng, brave, or tavily
SEARCH_PROVIDER=none
# JSON search must be enabled on your SearXNG instance.
SEARXNG_URL=http://127.0.0.1:8080/
BRAVE_API_KEY=
TAVILY_API_KEY=
